# Токени бот аз @BotFather. Бе он барнома дар реҷаи намоишӣ (demo) кор мекунад.
BOT_TOKEN=
BOT_USERNAME=
BOT_POLLING=1

# Суроғаи HTTPS-и Mini App (баъди туннел). Барои тугмаи Open App лозим аст.
WEBAPP_URL=

# Холи ҳол = SQLite маҳаллӣ. Барои PostgreSQL ё Neon (бе -pooler):
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Суроғаи оммавии бекенд. Дар Railway худкор аз RAILWAY_PUBLIC_DOMAIN гирифта мешавад.
# PUBLIC_URL=https://your-api.up.railway.app
PUBLIC_URL=

# Холи ҳол = маҳдудияти суръат дар хотира. Барои Redis:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# 1 = воридшавӣ бе Telegram (фақат барои таҳия). Агар BOT_TOKEN бошад, пешфарз 0 аст.
DEV_ALLOW_DEMO=

# Нигоҳдории файл. local ё s3 (AWS S3 / Cloudflare R2).
STORAGE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=auto

# Танҳо барои фронтенд (Vite). Дар Vercel ҳамин дуро гузоред.
# VITE_API_URL суроғаи Railway аст, бе /api дар охир.
VITE_API_URL=
VITE_BOT_USERNAME=
